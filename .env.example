# 이 파일을 .env.local로 복사한 뒤 값을 채운다. .env.local은 커밋하지 않는다.

# ── 브라우저에 노출돼도 되는 값 (NEXT_PUBLIC_ 접두사) ─────────────────
# Supabase 대시보드 > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# publishable(공개) 키. RLS가 걸려 있으므로 노출돼도 본인 데이터 외에는 접근할 수 없다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# OAuth 콜백 등 절대 URL이 필요할 때 사용 (로컬: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 서버 전용 값 (절대 NEXT_PUBLIC_ 붙이지 말 것) ─────────────────────
# Drizzle 마이그레이션·시드 전용 Postgres 연결 문자열 (앱 실행 중에는 쓰지 않는다)
# Supabase 대시보드 > Connect > Session pooler (5432 포트, IPv4 지원)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# 시드 스크립트가 데모 리뷰 작성자(auth 사용자)와 그들의 이용 완료 주문을 만들 때만 쓴다. 앱 코드에서는 쓰지 않는다.
# Supabase 대시보드 > Project Settings > API Keys > Secret keys
SUPABASE_SECRET_KEY=

# ── 선택 ─────────────────────────────────────────────────────────────
# 시드할 때 이 이메일 계정(이미 가입한 계정)에 "이용 완료" 주문 1건을 넣어 리뷰 작성 흐름을 확인할 수 있다.
SEED_BUYER_EMAIL=
# 시드할 때 이 계정을 관리자로 지정한다 (/admin). 이미 가입한 계정이어야 한다.
SEED_ADMIN_EMAIL=
# 시드할 때 이 계정을 데모 파트너(하루 트래블)의 소유자로 지정한다 (/partner).
# 1계정 1역할: 관리자와 다른 계정이어야 한다.
SEED_PARTNER_EMAIL=
